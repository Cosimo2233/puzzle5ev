# AXU5EV：外设别名须在接入实物后绑定。禁止使用厂家 MIPI /dev/video0。
EC_DRAW_ENABLED=false
EC_PREPROCESS_BACKEND=cpu
EC_RIGID_BACKEND=cpu
EC_CLEARANCE_BACKEND=cpu
EC_MOTION_ENABLED=false
EC_BLUE_RATIO_Q8=275
EC_BLUE_MIN=45
# 蓝灰扑克花纹的可选随机模式标定（默认关闭，见 docs/validation/cards-20261021.md）：
# TASK2_BLUE_RATIO_Q8=320
# TASK2_BLUE_BACKGROUND_FRACTION_Q8=218
EC_BRIGHTNESS_MIN=0
CAMERA_DEVICE_PATH=/dev/ec26e-camera
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_INPUT_FORMAT=mjpeg
CAMERA_FFMPEG_EXECUTABLE=/opt/ec26e/venv-python311/bin/ffmpeg
WORKSPACE_DETECT_WIDTH=640
WORKSPACE_DETECT_HEIGHT=360
A4_RESIZE_WIDTH=762
A4_RESIZE_HEIGHT=540
MOTION_BACKEND=m0
M0_BRIDGE_PORT=/dev/ec26e-m0-bridge
# Logical channel labels; only M0_BRIDGE_PORT is opened by the m0 backend.
MOTION_SERIAL_DEVICE=/dev/ec26e-m0-ch1
MOTION_SERIAL_BAUDRATE=115200
FOC_SERIAL_PORT=/dev/ec26e-m0-ch2
# 电磁铁通过 M0 PB8 控制，不申请 FPGA Linux GPIO。
TASK1_REVIEW_CYCLE_SECONDS=2
TASK2_REVIEW_CYCLE_SECONDS=2
TASK1_ALLOWED_JUMP_FRAMES=0
TASK2_ALLOWED_JUMP_FRAMES=0

# Mechanical values from the user-selected Radxa active profile (20261010).
# Reuses the existing mechanism; this is not a new physical calibration.
FOC_ADDRESS=2
FOC_RPM=15
MOTION_X_MIN_MM=0
MOTION_X_MAX_MM=230
MOTION_Y_MIN_MM=0
MOTION_Y_MAX_MM=360
MOTION_A4_ORIGIN_X_MM=18.5
MOTION_A4_ORIGIN_Y_MM=-8
MOTION_Z_BOOT_DEGREES=0
MOTION_Z_UP_DEGREES=90
MOTION_Z_DOWN_DEGREES=0
MOTION_XY_SPEED_MM_PER_SECOND=80
MOTION_XY_FIXED_WAIT_SECONDS=1.0
MOTION_Z_MOVE_WAIT_SECONDS=1.0
FOC_MAX_RPM=30
FOC_FEEDBACK_TIMEOUT_SECONDS=0.3
FOC_FEEDBACK_ATTEMPTS=3
MOTION_ROTATION_CLOCKWISE_SIGN=1
MOTION_Z_SPEED_LEVEL=64
MOTION_Z_ENABLE_WAIT_SECONDS=1.0
MOTION_ROTATION_ZERO_WAIT_SECONDS=1.0
MOTION_MAGNET_ATTACH_WAIT_SECONDS=0.3
MOTION_MAGNET_RELEASE_WAIT_SECONDS=0.3
